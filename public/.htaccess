# Set It Right — sito statico Astro su hosting Aruba (Apache).
# Sostituisce il .htaccess di WordPress: va caricato nella root del sito.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS e www --------------------------------------------------------
  # Aruba sta dietro un proxy: il protocollo originale arriva in
  # X-Forwarded-Proto. Se dopo il caricamento il sito va in loop di redirect,
  # sostituisci queste due regole con quelle del vecchio .htaccess di WordPress.
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.setitright.it/$1 [R=301,L]

  # --- Vecchi URL di WordPress ---------------------------------------------
  # Destinazioni assolute: dietro il proxy di Aruba un percorso relativo
  # diventerebbe http:// e costerebbe un secondo redirect.
  # Progetto Moioli rinominato su WordPress.
  RewriteRule ^progetto/una-direzione-marketing-esterna-non-un-semplice-intervento/?$ https://www.setitright.it/progetto/una-direzione-marketing-esterna-prefabbricati-moioli/ [R=301,L]
  # Vecchio articolo con la bozza dello scadenziario.
  RewriteRule ^scadenziario-app/?$ https://www.setitright.it/progetto/scadenziario-app/ [R=301,L]
  # Slug che il menu WP usava per "Metodologia" e pagina usata come home.
  RewriteRule ^come-lavoriamo-2/?$ https://www.setitright.it/come-lavoriamo/ [R=301,L]
  RewriteRule ^homepage/?$ https://www.setitright.it/ [R=301,L]
  # Sitemap di Yoast, probabilmente registrata in Search Console.
  RewriteRule ^sitemap_index\.xml$ https://www.setitright.it/sitemap-index.xml [R=301,L]
  RewriteRule ^(page|post|progetto|categoria_progetto|tecnologia_progetto)-sitemap\.xml$ https://www.setitright.it/sitemap-index.xml [R=301,L]
  # Feed, archivi e tassonomie dei progetti: non esistono più.
  RewriteRule ^(.*/)?feed/?$ https://www.setitright.it/ [R=301,L]
  RewriteRule ^progetto/?$ https://www.setitright.it/i-nostri-progetti/ [R=301,L]
  RewriteRule ^(categoria_progetto|tecnologia_progetto)/ https://www.setitright.it/i-nostri-progetti/ [R=301,L]
  # Area amministrativa: 410 (non esiste più) e niente traffico di bot a vuoto.
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [G,L]
  # Resti di WordPress che non si possono cancellare dal File Manager (wp-content
  # è bloccato su Aruba): il sito è statico, quindi nessun PHP deve girare e
  # plugin, temi e cache non devono essere raggiungibili. Le immagini in
  # wp-content/uploads restano servite per i vecchi link esterni.
  RewriteRule \.(php[0-9]?|phtml|phar)$ - [G,NC,L]
  RewriteRule ^wp-content/(plugins|themes|mu-plugins|upgrade|cache|languages|ai1wm-backups|updraft)(/|$) - [G,NC,L]
  RewriteRule ^wp-content/.*\.(log|sql|zip|gz|txt|json|ini)$ - [G,NC,L]
  RewriteRule ^wp-(config|settings|load|cron|blog-header|activate|signup|trackback|mail|links-opml)\b - [G,NC,L]

  # Slash finale, come le pagine generate da Astro (trailingSlash: 'always').
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/ -d
  RewriteRule ^(.*)$ https://www.setitright.it/$1/ [R=301,L]
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # I file in /_astro/ hanno l'hash nel nome: cambiano nome a ogni modifica.
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml
</IfModule>
