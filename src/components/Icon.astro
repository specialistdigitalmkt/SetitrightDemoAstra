---
// Icone estratte dai blocchi stackable/icon del tema: erano SVG inline negli
// attributi dei blocchi, non file in wp-content. Vengono iniettate inline così
// da poterne controllare colore (currentColor) e dimensione via CSS.
const icone = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 40, class: className } = Astro.props;

const svg = icone[`../icons/${name}.svg`];
if (!svg) throw new Error(`Icona non trovata: ${name}`);
---

<span class:list={['sir-icon', className]} style={`--sir-icon-size:${size}px`} aria-hidden="true" set:html={svg} />

<style>
  .sir-icon { display: inline-flex; color: currentColor; }
  .sir-icon :global(svg) {
    width: var(--sir-icon-size, 40px);
    height: var(--sir-icon-size, 40px);
  }
</style>
