---
import HeroBackground from './HeroBackground.astro';
import { site } from '../../data/site';
---

<section class="sir-hero">
  <HeroBackground />

  <div class="sir-hero__content">
    <!-- Nel tema WordPress questo testo era reso invisibile (colore trasparente):
         qui resta a disposizione di SEO e screen reader come H1 della pagina. -->
    <h1 class="sir-hero__h1">Supporto IT e marketing per aziende</h1>

    <img
      class="sir-hero__logo sir-enter"
      src={site.logo}
      alt={site.name}
      width="775"
      height="97"
      fetchpriority="high"
    />

    <p class="sir-hero__tagline sir-enter sir-enter--1">{site.tagline}</p>

    <p class="sir-hero__payoff sir-enter sir-enter--2">{site.payoff}</p>

    <p class="sir-hero__text sir-enter sir-enter--3">
      Quando IT e marketing non parlano tra loro, la tua azienda paga il conto.
      Noi siamo il punto di regia che mancava.
    </p>

    <div class="sir-btns sir-hero__actions sir-enter sir-enter--4">
      <a class="sir-btn sir-btn--fill" href="/i-nostri-progetti/">Portfolio</a>
      <a class="sir-btn sir-btn--outline" href="/contatti/">Contattaci</a>
    </div>
  </div>

  <a class="sir-hero__scroll" href="#problema-title">
    <span>Scopri</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .sir-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--sir-space-lg) var(--sir-space-md);
    background: var(--sir-black);
    color: var(--sir-white);
    overflow: hidden;
  }
  .sir-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--sir-content);
    text-align: center;
  }
  .sir-hero__h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .sir-hero__logo {
    width: min(775px, 100%);
    margin: 0 auto 20px;
  }
  .sir-hero__tagline {
    margin-bottom: var(--sir-space-md);
    font-size: clamp(18px, 3vw, 36px);
    line-height: 1.2;
    letter-spacing: 0.43px;
  }
  .sir-hero__payoff {
    margin: var(--sir-space-sm) 0;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 600;
  }
  .sir-hero__text {
    max-width: 620px;
    margin: 16px auto 0;
    color: var(--sir-white-60);
  }
  .sir-hero__actions { margin-top: 32px; }

  /* Entrata in scena al caricamento: l'hero si compone invece di apparire fatto. */
  .sir-enter {
    opacity: 0;
    animation: sir-enter 0.9s var(--sir-ease) forwards;
    animation-delay: var(--sir-enter-delay, 0.15s);
  }
  .sir-enter--1 { --sir-enter-delay: 0.35s; }
  .sir-enter--2 { --sir-enter-delay: 0.55s; }
  .sir-enter--3 { --sir-enter-delay: 0.7s; }
  .sir-enter--4 { --sir-enter-delay: 0.85s; }

  @keyframes sir-enter {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* Indicatore di scroll in fondo all'hero. */
  .sir-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--sir-white-60);
    font-size: var(--sir-fs-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    animation: sir-enter 0.9s var(--sir-ease) 1.1s backwards;
  }
  .sir-hero__scroll:hover { color: var(--sir-white); }
  .sir-hero__scroll span:last-child { animation: sir-scroll-bob 1.8s ease-in-out infinite; }

  @keyframes sir-scroll-bob {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(5px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sir-enter { opacity: 1; animation: none; }
    .sir-hero__scroll { animation: none; }
    .sir-hero__scroll span:last-child { animation: none; }
  }

  @media (max-width: 700px) {
    .sir-hero { padding: var(--sir-space-md) var(--sir-space-sm); }
  }
</style>
