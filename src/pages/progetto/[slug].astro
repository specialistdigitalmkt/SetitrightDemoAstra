---
import Base from '../../layouts/Base.astro';
import { progetti } from '../../data/progetti';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() =>
  progetti.map((progetto) => ({
    params: { slug: progetto.slug },
    props: { progetto },
  }))) satisfies GetStaticPaths;

const { progetto } = Astro.props;
const altri = progetti.filter((p) => p.slug !== progetto.slug).slice(0, 3);
---

<Base title={progetto.titolo} description={progetto.abstract}>
  <section class="sir-hero-progetto">
    {/* Come il blocco cover del tema WP: immagine del progetto con velatura nera all'80%. */}
    <img class="sir-hero-progetto__bg" src={progetto.immagine} alt="" loading="eager" fetchpriority="high" />
    <div class="sir-container sir-hero-progetto__inner">
      <div class="sir-stack sir-stack--xs">
        <nav class="sir-breadcrumb sir-small" aria-label="Percorso">
          <a href="/">Home</a> / <a href="/i-nostri-progetti/">Progetti</a> /{' '}
          <span aria-current="page">{progetto.nomeBreve}</span>
        </nav>
        <span class="sir-eyebrow">{progetto.categoriaLabel}</span>
        <h1>{progetto.titolo}</h1>
        {progetto.intro.map((par) => <p class="sir-lead">{par}</p>)}
      </div>
      <img class="sir-hero-progetto__logo" src={progetto.logo} alt={progetto.cliente.nome} loading="eager" />
    </div>
  </section>

  <section class="sir-section" aria-labelledby="panoramica-title">
    <div class="sir-container sir-panoramica">
      <div class="sir-stack sir-stack--sm">
        <h2 id="panoramica-title">Panoramica progetto</h2>
        {progetto.panoramica.map((par) => <p class="sir-muted sir-testo">{par}</p>)}
      </div>

      <dl class="sir-scheda sir-reveal-right">
        <div class="sir-scheda__item sir-scheda__item--wide">
          <dt>Cliente</dt>
          <dd>
            {
              progetto.cliente.url ? (
                <a href={progetto.cliente.url} rel="noopener noreferrer" target="_blank">
                  {progetto.cliente.nome}
                </a>
              ) : (
                progetto.cliente.nome
              )
            }
            {progetto.cliente.descrizione && (
              <span class="sir-scheda__nota">{progetto.cliente.descrizione}</span>
            )}
          </dd>
        </div>
        <div class="sir-scheda__item">
          <dt>Durata</dt>
          <dd>{progetto.durata}</dd>
        </div>
        <div class="sir-scheda__item">
          <dt>Anno</dt>
          <dd>{progetto.anno}</dd>
        </div>
        <div class="sir-scheda__item sir-scheda__item--wide">
          <dt>Servizi</dt>
          <dd>{progetto.servizi}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="sir-section sir-on-gray" aria-labelledby="sfide-title">
    <div class="sir-container sir-stack sir-stack--md">
      <h2 id="sfide-title" class="sir-center">Le sfide</h2>
      <div class="sir-grid sir-grid--3">
        {
          progetto.sfide.map((s, i) => (
            <article class:list={['sir-card', 'sir-card--strong', 'sir-reveal-left', `sir-delay-${i + 1}`]}>
              <p class="sir-card__title">{s.titolo}</p>
              <p class="sir-card__text">{s.testo}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sir-section" aria-labelledby="soluzione-title">
    <div class="sir-container sir-stack sir-stack--md">
      <h2 id="soluzione-title" class="sir-center">La soluzione</h2>
      <div class="sir-grid sir-grid--3">
        {
          progetto.soluzione.map((s, i) => (
            <article class:list={['sir-card', 'sir-reveal-left', `sir-delay-${i + 1}`]}>
              <p class="sir-card__title">{s.titolo}</p>
              <p class="sir-card__text">{s.testo}</p>
            </article>
          ))
        }
      </div>

      <div class="sir-stack sir-stack--xs sir-center sir-tecnologie">
        <h3>Tecnologie e strumenti</h3>
        <div class="sir-tecnologie__lista">
          {progetto.tecnologie.map((t) => <span class="sir-tag">{t}</span>)}
        </div>
      </div>
    </div>
  </section>

  {
    progetto.risultati.length > 0 && (
      <section class="sir-risultati" aria-labelledby="risultati-title">
        <div class="sir-container sir-stack sir-stack--md">
          <h2 id="risultati-title" class="sir-center">
            I risultati
          </h2>
          <div class="sir-grid sir-grid--4">
            {progetto.risultati.map((r) => (
              <div class="sir-risultato sir-reveal-up">
                {r.valore && (
                  <span class="sir-risultato__valore" data-conta={r.valore}>
                    {r.valore}
                  </span>
                )}
                <span class="sir-risultato__etichetta">{r.etichetta}</span>
                {r.descrizione && <span class="sir-risultato__desc">{r.descrizione}</span>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="sir-section" aria-labelledby="altri-title">
    <div class="sir-container sir-stack sir-stack--sm">
      <h2 id="altri-title" class="sir-center">Altri progetti</h2>
      <ul class="sir-altri">
        {
          altri.map((p) => (
            <li>
              <a href={`/progetto/${p.slug}/`}>
                <span class="sir-eyebrow">{p.categoriaLabel}</span>
                <span>{p.titolo}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sir-btns">
        <a class="sir-btn sir-btn--outline" href="/i-nostri-progetti/">Vedi tutti i progetti</a>
      </div>
    </div>
  </section>

  <section class="sir-section sir-portfolio-cta">
    <div class="sir-portfolio-cta__box">
      <h3>Vuoi costruire un progetto simile?</h3>
      <p>
        Possiamo aiutarti a coordinare comunicazione, presenza digitale e infrastruttura operativa in
        modo più ordinato.
      </p>
      <div class="sir-btns">
        <a class="sir-btn sir-btn--fill" href="/contatti/">Parliamone</a>
      </div>
    </div>
  </section>
  <script>
    // I numeri dei risultati salgono da zero quando la sezione entra in vista.
    // Il valore è testo libero (1.135, +78%, 300GB+, SEO): si anima solo la parte
    // numerica, conservando prefisso e suffisso; se non ce n'è, resta com'è.
    const valori = document.querySelectorAll<HTMLElement>('[data-conta]');
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (valori.length && !ridotto && 'IntersectionObserver' in window) {
      const anima = (el: HTMLElement) => {
        const testo = el.dataset.conta ?? '';
        const match = testo.match(/^(\D*)([\d.,]+)(.*)$/);
        if (!match) return;

        const [, prefisso, numero, suffisso] = match;
        const separatore = numero.includes('.') && !numero.includes(',');
        const finale = Number(numero.replace(/\./g, '').replace(',', '.'));
        if (!Number.isFinite(finale)) return;

        const decimali = numero.includes(',') ? 1 : 0;
        const durata = 1100;
        const avvio = performance.now();

        const passo = (ora: number) => {
          const t = Math.min((ora - avvio) / durata, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          const corrente = finale * eased;
          const formattato = separatore
            ? Math.round(corrente).toLocaleString('it-IT')
            : corrente.toFixed(decimali).replace('.', ',');
          el.textContent = `${prefisso}${formattato}${suffisso}`;
          if (t < 1) requestAnimationFrame(passo);
          else el.textContent = testo;
        };

        requestAnimationFrame(passo);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            anima(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.5 }
      );

      valori.forEach((el) => observer.observe(el));
    }
  </script>
</Base>

<style>
  .sir-hero-progetto {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(78vh, 760px);
    padding: var(--sir-space-lg) var(--sir-space-sm);
    overflow: hidden;
    background: var(--sir-black);
    color: var(--sir-white);
  }
  .sir-hero-progetto__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: scale(1.04);
    animation: sir-hero-zoom 14s ease-out forwards;
  }
  .sir-hero-progetto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.86) 55%, rgba(0, 0, 0, 0.8) 100%);
  }
  .sir-hero-progetto__inner { position: relative; z-index: 1; }
  .sir-hero-progetto h1 { max-width: 20ch; }
  @keyframes sir-hero-zoom { to { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    .sir-hero-progetto__bg { animation: none; transform: none; }
  }
  .sir-hero-progetto__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sir-space-md);
  }
  .sir-hero-progetto .sir-eyebrow,
  .sir-hero-progetto .sir-lead { color: rgba(255, 255, 255, 0.78); }
  .sir-hero-progetto .sir-lead { max-width: 62ch; }
  .sir-breadcrumb { margin-bottom: 8px; color: var(--sir-white-60); }
  .sir-breadcrumb a { color: inherit; text-decoration: none; }
  .sir-breadcrumb a:hover { color: var(--sir-white); }
  .sir-breadcrumb [aria-current] { color: var(--sir-white); }
  .sir-hero-progetto__logo {
    flex: none;
    width: clamp(80px, 12vw, 120px);
    height: auto;
    background: var(--sir-white);
    padding: 12px;
  }


  .sir-testo { line-height: 1.75; }

  .sir-panoramica {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--sir-space-md);
    align-items: start;
  }
  .sir-scheda {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 24px;
    margin: 0;
  }
  .sir-scheda__item { padding-top: 18px; border-top: 1.5px solid var(--sir-ink); }
  .sir-scheda__item--wide { grid-column: 1 / -1; }
  .sir-scheda dt {
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--sir-gray-500);
  }
  .sir-scheda dd { margin: 0; font-size: 18px; font-weight: 500; line-height: 1.4; }
  .sir-scheda dd a { color: inherit; }
  .sir-scheda__nota { display: block; margin-top: 4px; font-size: 14px; font-weight: 400; color: var(--sir-gray-500); }

  .sir-tecnologie { margin-top: var(--sir-space-sm); }
  .sir-tecnologie__lista { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }

  .sir-risultati {
    padding: var(--sir-space-xl) var(--sir-space-sm);
    background: var(--sir-ink);
    color: var(--sir-white);
  }
  .sir-risultato { display: flex; flex-direction: column; gap: 8px; text-align: center; }
  .sir-risultato__valore {
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
  }
  .sir-risultato__etichetta {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .sir-risultato__desc { font-size: 14px; line-height: 1.6; color: rgba(255, 255, 255, 0.58); }

  .sir-altri { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--sir-gray-300); }
  .sir-altri a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px var(--sir-space-sm);
    background: var(--sir-white);
    text-decoration: none;
    transition: background-color 0.2s var(--sir-ease);
  }
  .sir-altri a:hover { background: var(--sir-gray-50); }

  .sir-portfolio-cta { padding-top: 32px; }
  .sir-portfolio-cta__box {
    max-width: 800px;
    margin-inline: auto;
    padding: 48px 24px;
    background: var(--sir-ink);
    color: var(--sir-white);
    text-align: center;
  }
  .sir-portfolio-cta__box h3 { margin-bottom: 16px; }
  .sir-portfolio-cta__box p {
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .sir-panoramica { grid-template-columns: 1fr; }
  }

  @media (max-width: 700px) {
    .sir-hero-progetto__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
