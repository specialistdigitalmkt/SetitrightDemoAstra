---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina non trovata">
  <section class="sir-section sir-on-dark" style="min-height:60vh;display:flex;align-items:center">
    <div class="sir-container--narrow sir-container sir-stack sir-stack--sm sir-center">
      <p class="sir-eyebrow">Errore 404</p>
      <h1>Questa pagina non c’è (più)</h1>
      <p class="sir-lead">Torna alla home o guarda i progetti che seguiamo.</p>
      <div class="sir-btns">
        <a class="sir-btn sir-btn--fill" href="/">Home</a>
        <a class="sir-btn sir-btn--outline" href="/i-nostri-progetti/">Progetti</a>
      </div>
    </div>
  </section>
</Base>
